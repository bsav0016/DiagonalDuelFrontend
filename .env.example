# Copy to .env for local development: cp .env.example .env   (Windows: copy .env.example .env)
# .env is gitignored. EXPO_PUBLIC_ variables are bundled into the app, so never put secrets here.

# Backend the app talks to. Leave unset (or commented out) to use the hosted production server.
# For a local backend use your computer's LAN address so a phone or emulator can reach it
# (the Android emulator can also use http://10.0.2.2:8000). Restart Expo after changing this.
# EXPO_PUBLIC_API_URL=http://192.168.0.10:8000/
